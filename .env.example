# Required API configuration
BASECAMP_ACCOUNT_ID=your_basecamp_account_id
BASECAMP_ACCESS_TOKEN=
BASECAMP_USER_AGENT=Basecamp MCP Server (you@example.com)

# Enable mutation tools only when you intend to use them
BASECAMP_ENABLE_WRITE_TOOLS=false

# Preview-bound confirmation tokens for sensitive card workflow writes
BASECAMP_CONFIRMATION_TTL_SECONDS=300

# OAuth application configuration
BASECAMP_CLIENT_ID=your_oauth_client_id
BASECAMP_CLIENT_SECRET=your_oauth_client_secret
BASECAMP_REDIRECT_URI=http://localhost:8000/callback
BASECAMP_REFRESH_TOKEN=
BASECAMP_ACCESS_TOKEN_EXPIRES_AT=

# Optional tuning
BASECAMP_API_BASE=https://3.basecampapi.com
BASECAMP_TIMEOUT_SECONDS=30
BASECAMP_MAX_PAGES=100
BASECAMP_MAX_RETRIES=2
